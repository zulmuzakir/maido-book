ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Google OAuth
# https://www.better-auth.com/docs/authentication/google
# Redirect URI to register in Google Cloud: <ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated Google account emails allowed to sign in (case-insensitive).
# Production: wrangler secret put ALLOWED_EMAILS
ALLOWED_EMAILS=""
